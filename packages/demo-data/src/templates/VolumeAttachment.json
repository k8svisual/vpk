{
  "apiVersion": "storage.k8s.io/v1",
  "kind": "VolumeAttachment",
  "metadata": {
    "name": "{{name}}"
  },
  "spec": {
    "attacher": "demo.csi.example.com",
    "nodeName": "{{nodeName}}",
    "source": {
      "persistentVolumeName": "{{targetName}}"
    }
  },
  "status": {
    "attached": true
  }
}
