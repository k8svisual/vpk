{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "{{name}}",
    "namespace": "{{namespace}}"
  },
  "spec": {
    "parentRefs": [
      {
        "name": "{{gatewayName}}"
      }
    ],
    "hostnames": [
      "example.com"
    ],
    "rules": [
      {
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/"
            }
          }
        ],
        "backendRefs": [
          {
            "name": "{{serviceName}}",
            "port": 8080
          }
        ]
      }
    ]
  },
  "status": {
    "parents": [
      {
        "parentRef": {
          "name": "{{gatewayName}}"
        },
        "controllerName": "example.net/gateway-controller",
        "conditions": [
          {
            "type": "Accepted",
            "status": "True",
            "reason": "Accepted",
            "message": "Route accepted",
            "lastTransitionTime": "2024-01-01T00:00:00Z",
            "observedGeneration": 1
          },
          {
            "type": "ResolvedRefs",
            "status": "True",
            "reason": "ResolvedRefs",
            "message": "All references resolved",
            "lastTransitionTime": "2024-01-01T00:00:00Z",
            "observedGeneration": 1
          }
        ]
      }
    ]
  }
}
