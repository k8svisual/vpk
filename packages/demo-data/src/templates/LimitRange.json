{
  "apiVersion": "v1",
  "kind": "LimitRange",
  "metadata": {
    "name": "{{name}}",
    "namespace": "{{namespace}}"
  },
  "spec": {
    "limits": [
      {
        "default": {
          "cpu": "500m",
          "memory": "512Mi"
        },
        "defaultRequest": {
          "cpu": "100m",
          "memory": "128Mi"
        },
        "type": "Container"
      }
    ]
  }
}
