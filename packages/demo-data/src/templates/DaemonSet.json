{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "name": "{{name}}",
    "namespace": "{{namespace}}"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app": "{{name}}"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "{{name}}"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "{{image}}"
          }
        ]
      }
    }
  }
}
