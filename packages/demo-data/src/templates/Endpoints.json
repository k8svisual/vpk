{
  "apiVersion": "v1",
  "kind": "Endpoints",
  "metadata": {
    "name": "{{name}}",
    "namespace": "{{namespace}}"
  },
  "subsets": [
    {
      "addresses": [
        {
          "ip": "{{podIP}}"
        }
      ],
      "ports": [
        {
          "port": 8080
        }
      ]
    }
  ]
}
