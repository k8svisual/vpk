{
  "name": "vpk-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/demo-data/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "bun packages/server/src/server.ts",
    "dev:web": "cd packages/web && bun run dev",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
