{
  "name": "vpk-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/demo-data/tsconfig.json && tsc --noEmit -p packages/training/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "bun packages/server/src/server.ts",
    "dev:web": "cd packages/web && bun run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:web": "cd packages/web && bun run build",
    "build:web-assets": "bun scripts/build-web-assets.ts",
    "build:course-assets": "bun scripts/build-course-assets.ts",
    "build:binary": "bun scripts/build-binary.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "bun-types": "^1.3.14",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
